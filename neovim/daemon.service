[Unit]
Description=NeoVim Podman Daemon
After=network.target

[Service]
Type=simple
Environment=XDG_RUNTIME_DIR=/run/user/%U
Environment=REGISTRY_AUTH_FILE=%h/.config/containers/auth.json
Environment=CONTAINERS_DEVICE_PROVIDER=match
ExecStart=/usr/bin/podman start -a neovim-daemon
ExecStop=/usr/bin/podman stop -t 2 neovim-daemon
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
